# Copy to .env to override the DEV-ONLY defaults baked into docker-compose.yml.
# MINIO_ROOT_USER=lakehouse-admin
# MINIO_ROOT_PASSWORD=dev-only-change-me
# LAKEKEEPER_S3_ACCESS_KEY=lakekeeper
# LAKEKEEPER_S3_SECRET_KEY=dev-only-lakekeeper-secret
# LAKEKEEPER_ENCRYPTION_KEY=dev-only-encryption-key-change-me
# POSTGRES_PASSWORD=dev-only-postgres
# LAKEKEEPER_DB_PASSWORD=dev-only-lakekeeper
# DAGSTER_PG_PASSWORD=dev-only-dagster
# GRAFANA_ADMIN_PASSWORD=dev-only-grafana
# Host ports
# TRINO_PORT=8080
# LAKEKEEPER_PORT=8181
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# DAGSTER_PORT=3030
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3031
# Memory limits
# TRINO_MEM_LIMIT=3g
# WORKBENCH_MEM_LIMIT=3g
# SPARK_MEM_LIMIT=3g
